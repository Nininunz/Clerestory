<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Clerestory</string>
	<key>CFBundleName</key>
	<string>Clerestory</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 weijue and Nicholas Nunziata. MIT License.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>When experimental Now Playing is enabled and the compatibility helper is unavailable, Clerestory can read and control Apple Music or Spotify.</string>
	<!-- Sparkle 2 automatic updates. The feed is hosted on GitHub Pages (docs/appcast.xml). -->
	<key>SUFeedURL</key>
	<string>https://nininunz.github.io/Clerestory/appcast.xml</string>
	<!-- EdDSA public key (the private key is stored in the login keychain, item "Private key for signing Sparkle updates"). -->
	<key>SUPublicEDKey</key>
	<string>9FwNUDtPRvp+rmGcGlv6jXBhVeCE3NuBshjbN2r5s0o=</string>
	<!-- In the sandbox, the Installer XPC Service must be enabled for the app to replace itself,
	     per the Sparkle sandboxing docs:
	     "The Installer XPC Service is required for Sandboxed applications. …
	     you must set SUEnableInstallerLauncherService boolean to `YES` in your
	     application's Info.plist."
	     — https://sparkle-project.org/documentation/sandboxing/
	     The XPC service ships embedded in Sparkle.framework (SwiftPM binary target) and is
	     loaded by Sparkle from inside the framework bundle (SPUUpdater's validation logic
	     also requires this). -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
</dict>
</plist>
