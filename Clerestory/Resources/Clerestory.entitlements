<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Experimental media fallback. Apple Events are requested only
	     after the user enables Now Playing and the bundled adapter is unavailable. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events</key>
	<array>
		<string>com.apple.Music</string>
		<string>com.spotify.client</string>
	</array>
	<!-- Sparkle update checks are the app's only network activity (GitHub Pages appcast +
	     Releases DMG). With network.client granted, the Sparkle sandboxing docs say the
	     Downloader XPC Service should not be enabled:
	     "If your sandboxed application already needs to use this entitlement for
	     network access, then you should not enable the Downloader XPC Service."
	     — https://sparkle-project.org/documentation/sandboxing/ -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required by Sparkle's sandboxed mode: allow looking up the Mach services of its
	     installer tools (-spki for installing / -spks for status). This is the temporary
	     exception required by the "Communication" section of the same docs. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>
